@page "/usermgmt"
@* admins page *@

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using WebUI.Areas.Identity.Data
@using P7_UrbanRead
@inject UserManager<WebUIUser> UserManager
@inject IDbContextFactory<WebUIContext> IDbContextFactory
@inject RoleManager<IdentityRole> RoleManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<style>
    /* subtle greyed-out look for disabled selects */
    .disabled-select {
        opacity: 0.6;
        pointer-events: none; /* prevents interaction */
    }
</style>

<AuthorizeView Roles="Admin, Member">
    <Authorized>

        <PageTitle>List of Users</PageTitle>

        <div class="grid">
            <QuickGrid TItem="WebUIUser" Class="table" Items="_users.AsQueryable()">
                <PropertyColumn Property="_usermgmt => _usermgmt._Person.Id" Title="ID" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Ascending" />
                <PropertyColumn Property="_usermgmt => _usermgmt._Person.FirstName" Title="First Name" />
                <PropertyColumn Property="_usermgmt => _usermgmt._Person.LastName" Title="Last Name" />
                <PropertyColumn Property="_usermgmt => _usermgmt.UserName" Title="Username" />
                
                <TemplateColumn Context="_userRoleContext" Title="Permission">
                    @if (_usersRoles.TryGetValue(_userRoleContext.Id, out var currentRole))
                    {
                        <select class="form-select form-select-sm @(CanEditPermission(_userRoleContext) ? string.Empty : "disabled-select")"
                                value="@currentRole"
                                disabled="@( !CanEditPermission(_userRoleContext) )"
                                @onchange="async e => await SaveUserPermission(_userRoleContext.Id, e.Value?.ToString())">
                            @foreach (var _role in _Roles)
                            {
                                <option value="@_role">@_role</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span>Loading...</span>
                    }
                </TemplateColumn>                
                <TemplateColumn Context="_userContext" Title="Action">
                    <a href="@($"/usermgmt/details?id={_userContext.Id}")">Details</a>
                </TemplateColumn>

            </QuickGrid> 
        </div>
    </Authorized>
    <NotAuthorized>
        <p>Access denied!</p>
        <p>Admin permission required.</p>
    </NotAuthorized>
</AuthorizeView>


@code {

    // materialized list for the grid
    List<WebUIUser> _users { get; set; } = new();

    //Collection that stores key-value pairs. Id -> role name
    Dictionary<string, string> _usersRoles { get; set; } = new();

    //List of roles to populate the Permission column dropdown options
    List<string> _Roles = new() {"Admin","Member" };

    // track whether current viewer is an admin
    bool _currentUserIsAdmin;

    protected override async Task OnInitializedAsync()
    {
        // determine current user's roles
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserIsAdmin = user.IsInRole("Admin");

        // create a context and materialize users for UI binding
        using var _context = await IDbContextFactory.CreateDbContextAsync();
        _users = await _context.Users.Include(u => u._Person).ToListAsync();

        // populate role cache (can be batched for performance)
        foreach (var u in _users)
        {
            await GetUserRoleString(u);
        }

        StateHasChanged();
    }

    // decide whether the current viewer can change the target's permission
    bool CanEditPermission(WebUIUser target)
    {
        // Option A (simple): only Admins can edit permissions
        if (!_currentUserIsAdmin) return false;

        // Option B (optional): prevent editing other Admins' roles even if you're Admin.
        // Uncomment if you want to prevent changing Admin accounts:
        if (_usersRoles.TryGetValue(target.Id, out var role) && role == "Admin" && target.Email == "admin@urban.com") return false;

        return true;
    }

    async Task<string> GetUserRoleString(WebUIUser _qUser)
    {
        if (_usersRoles.TryGetValue(_qUser.Id, out var cached))
            return cached;

        using var _context = await IDbContextFactory.CreateDbContextAsync();
        var _userRole = await _context.UserRoles.FirstOrDefaultAsync(r => r.UserId == _qUser.Id);
        var _role = _userRole != null ? await _context.Roles.FirstOrDefaultAsync(r => r.Id == _userRole.RoleId) : null;
        var _roleNormalized = _role?.Name ?? "Member";

        var _roleName = _roleNormalized.Contains("Admin") ? "Admin" : "Member";
        _usersRoles[_qUser.Id] = _roleName;

        return _roleName;
    }

    async Task SaveUserPermission (string _userId, string? _selectedRole)
    {
        if (string.IsNullOrWhiteSpace(_selectedRole)) return;

        var _user = await UserManager.FindByIdAsync(_userId);

        if (_user != null)
        {
            var _currentRoles = await UserManager.GetRolesAsync(_user);
            var _allowedRoles = new[] {"Admin","Member" };

            bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Save changes?");
            if (confirm == true)
            {
                var _toRemove = _currentRoles.Where(_role => _allowedRoles.Contains(_role)).ToList();
                if (_toRemove.Any())
                {
                    await UserManager.RemoveFromRolesAsync(_user, _toRemove);
                }

                await UserManager.AddToRoleAsync(_user, _selectedRole);

                _usersRoles[_userId] = _selectedRole;

                StateHasChanged();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("location.reload");
            }

        }
    }

}
